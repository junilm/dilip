{
	"name": "dilip",
	"main": "worker/index.js",
	"compatibility_date": "2026-08-27",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dilip-testimonials",
			"database_id": "1c2da13e-74bb-45f1-88d5-27442301ea85"
		}
	],
	"vars": {
		"TURNSTILE_SITE_KEY": ""
	}
}
